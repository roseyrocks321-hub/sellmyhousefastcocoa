# BEGIN Cocoa SEO Rewrite
RewriteEngine On

# 301 Redirects: City pages consolidated to Brevard (prevents cannibalization)
Redirect 301 /sell-my-house-fast-cocoa.html https://sellmyhousefastbrevardfl.com/sell-my-house-fast-cocoa
Redirect 301 /sell-my-house-fast-cocoa-beach.html https://sellmyhousefastbrevardfl.com/sell-my-house-fast-cocoa-beach
Redirect 301 /sell-my-house-fast-cape-canaveral.html https://sellmyhousefastbrevardfl.com/sell-my-house-fast-cape-canaveral
Redirect 301 /sell-my-house-fast-merritt-island.html https://sellmyhousefastbrevardfl.com/sell-my-house-fast-merritt-island
Redirect 301 /sell-my-house-fast-titusville.html https://sellmyhousefastbrevardfl.com/sell-my-house-fast-titusville
Redirect 301 /sell-my-house-fast-rockledge.html https://sellmyhousefastbrevardfl.com/sell-my-house-fast-rockledge
Redirect 301 /sell-my-house-fast-viera.html https://sellmyhousefastbrevardfl.com/sell-my-house-fast-viera
Redirect 301 /sell-my-house-fast-melbourne.html https://sellmyhousefastbrevardfl.com/sell-my-house-fast-melbourne
Redirect 301 /sell-my-house-fast-palm-bay.html https://sellmyhousefastbrevardfl.com/sell-my-house-fast-palm-bay
Redirect 301 /sell-my-house-fast-satellite-beach.html https://sellmyhousefastbrevardfl.com/sell-my-house-fast-satellite-beach
Redirect 301 /sell-my-house-fast-melbourne-beach.html https://sellmyhousefastbrevardfl.com/sell-my-house-fast-melbourne-beach
Redirect 301 /sell-my-house-fast-indian-harbour-beach.html https://sellmyhousefastbrevardfl.com/sell-my-house-fast-indian-harbour-beach
Redirect 301 /sell-my-house-fast-indialantic.html https://sellmyhousefastbrevardfl.com/sell-my-house-fast-indialantic

# Redirect parameter URLs to homepage (fixes ?shops/ duplicate)
RewriteCond %{QUERY_STRING} ^
RewriteRule ^(.*)\?shops/.*$ / [R=301,L]

# Remove trailing slashes for clean URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

# Serve .html files without extension in URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.html$
RewriteRule ^(.*)$ $1.html [L]

# Block common spam bots
RewriteCond %{HTTP_USER_AGENT} (MJ12bot|SemrushBot|AhrefsBot|DotBot|BLEXBot) [NC]
RewriteRule .* - [F,L]

# BEGIN Compression & Caching
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
